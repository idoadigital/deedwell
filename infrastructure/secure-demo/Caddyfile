# Unified secure-demo origin: static app + /api + /sites under ONE origin.
# The app is served directly by Caddy with immutable caching for hashed
# assets — repeat visits skip re-downloading the bundle and avatars.
{
	admin off
	auto_https off
}

:8080 {
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy localhost:3001
	}
	handle /sites/* {
		uri strip_prefix /sites
		reverse_proxy localhost:8788
	}
	handle {
		root * /root/deedwell/apps/desktop/dist
		encode gzip
		@immutable path /assets/* /avatars/* /downloads/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
